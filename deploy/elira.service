[Unit]
Description=Elira HTTP server and reverse proxy
Documentation=https://github.com/xelira/elira
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elira
Group=elira
ExecStart=/usr/local/bin/elira run --config /etc/elira/elira.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

# Binding 80/443 does not require running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StateDirectory=elira
ReadWritePaths=/var/lib/elira

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
